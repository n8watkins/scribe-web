{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Requests are served straight from out/. The one script, worker/index.js,
  // runs only for /videos/* to answer byte-range requests, which Safari needs.
  "name": "scribe-web",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/videos/*"]
  },
  // Workers Logs keeps every invocation of the script (the /videos/* requests);
  // assets served without the script produce no log entries.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "scribe.n8builds.dev", "custom_domain": true }]
}
