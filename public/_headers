# Served by Cloudflare Workers static assets (see DEPLOY.md).
# The App Router emits inline bootstrap scripts for statically generated pages,
# so script-src must permit those scripts. Everything a page loads is self-hosted.
# Pages carry no no-transform, so the n8builds.dev zone injects its Cloudflare
# Web Analytics beacon, which reports to /cdn-cgi/rum on this origin; the CSP
# allows the beacon script and Sentry's ingest host (lib/error-reporting.ts).
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: off
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; script-src-attr 'none'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self' https://o4507767562371072.ingest.us.sentry.io; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests

# Uptime check (OpenPing): a static file, so it costs no Worker run.
/healthz
  ! Cache-Control
  Cache-Control: no-store
  Content-Type: text/plain; charset=utf-8

# Hashed build output never changes, so browsers may cache it for a year.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

# The share card is written without a file extension, so name its type.
/opengraph-image
  Content-Type: image/png
